{
  "name": "netflicks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/netflicks/src",
  "projectType": "application",
  "prefix": "nf",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/netflicks",
          "browser": ""
        },
        "index": {
          "input": "apps/netflicks/src/index.html",
          "output": "index.html"
        },
        "browser": "apps/netflicks/src/main.ts",
        "polyfills": ["apps/netflicks/src/polyfills.ts"],
        "tsConfig": "apps/netflicks/tsconfig.app.json",
        "assets": [
          "apps/netflicks/src/fevicon.ico",
          "apps/netflicks/src/assets"
        ],
        "styles": [
          "apps/netflicks/src/styles.scss",
          "node_modules/bootstrap/scss/bootstrap.scss",
          "node_modules/swiper/swiper.scss",
          "node_modules/primeicons/primeicons.css"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "scripts": [
          "./node_modules/jquery/dist/jquery.min.js",
          "./node_modules/popper.js/dist/umd/popper.min.js",
          "./node_modules/bootstrap/dist/js/bootstrap.min.js"
        ],
        "extractLicenses": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/netflicks/src/environments/environment.ts",
              "with": "apps/netflicks/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "netflicks:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "netflicks:build:production"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "netflicks:build"
      }
    },
    "server": {
      "executor": "@angular-devkit/build-angular:server",
      "defaultConfiguration": "",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/netflicks/server",
        "main": "server.ts",
        "tsConfig": "tsconfig.server.json",
        "sourceMap": true,
        "optimization": false
      },
      "configurations": {
        "production": {
          "outputHashing": "media",
          "fileReplacements": [
            {
              "replace": "src/environments/environment.ts",
              "with": "src/environments/environment.prod.ts"
            }
          ],
          "sourceMap": false,
          "optimization": true
        }
      }
    },
    "serve-ssr": {
      "executor": "@nguniversal/builders:ssr-dev-server",
      "options": {
        "buildTarget": "netflicks:build",
        "serverTarget": "netflicks:server"
      },
      "configurations": {
        "production": {
          "buildTarget": "netflicks:build:production",
          "serverTarget": "netflicks:server:production"
        }
      }
    },
    "prerender": {
      "executor": "@nguniversal/builders:prerender",
      "options": {
        "buildTarget": "netflicks:build:production",
        "serverTarget": "netflicks:server:production",
        "routes": ["/"]
      },
      "configurations": {
        "production": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/netflicks/src/**/*.ts",
          "apps/netflicks/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/netflicks"],
      "options": {
        "jestConfig": "apps/netflicks/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
